@page "/Patient/{PatientId:guid}"
@using System.Globalization
@using MudBlazor
@using FitTheraPortal.Client.DataServices.Interfaces
@using FitTheraPortal.Client.DataServices.Interfaces
@using FitTheraPortal.Client.Dtos
@using FitTheraPortal.Client.Components.InjuryTreatmentPlan
@using FitTheraPortal.Client.Components.Injury

@inject IPatientDataService PatientService
@inject ISnackbar Snackbar
@inject IInjuryDataService InjuryService
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" GutterBottom="true">Patient Details</MudText>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (_patient == null)
    {
        <MudAlert Severity="Severity.Error">Error: Patient not found.</MudAlert>
    }
    else if (_patient.Profile != null)
    {
        <MudPaper Class="p-4 mb-6">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Phone</MudText>
                    <MudText>@_patient.Profile.FirstName @_patient.Profile.LastName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Phone</MudText>
                    <MudText>@_patient.Profile.PhoneNumber</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Email</MudText>
                    <MudText>@_patient.Profile.Email</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Gender</MudText>
                    <MudText>@_patient.Profile.Gender</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Address</MudText>
                    <MudText>
                        @_patient.Profile.StreetAddress<br />
                        @_patient.Profile.City, @_patient.Profile.State @_patient.Profile.ZipCode
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Birthdate</MudText>
                    <MudText>@_patient.Profile.Birthdate.ToString("D", CultureInfo.CurrentCulture)</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
    else
    {
        <MudAlert Severity="Severity.Warning">No profile information available.</MudAlert>
    }

    @if (_patientInjuries?.Any() == true)
    {
        <MudText Typo="Typo.h5" Class="mt-6 mb-2">Injuries</MudText>

        @foreach (var injury in _patientInjuries)
        {
            <MudPaper Class="mb-4 p-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@(() => ShowNewPlanDialog(injury.Id))"
                           StartIcon="@Icons.Material.Filled.Add">
                    New Treatment Plan
                </MudButton>

                <MudDivider Class="my-2" />
                <InjuryCard Injury="injury" />
            </MudPaper>
        }
    }

    <MudDialog />
</MudContainer>

@code {
    [Parameter] public Guid PatientId { get; set; }

    private PatientDto? _patient;
    private IEnumerable<InjuryDto>? _patientInjuries;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await GetPatientInfo();
        await GetPatientInjuries();
    }

    private async Task GetPatientInfo()
    {
        try
        {
            _patient = await PatientService.GetPatientAsync(PatientId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            Console.WriteLine($"Error in PatientDetails.razor: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task GetPatientInjuries()
    {
        try
        {
            _patientInjuries = await InjuryService.GetByUserAsync(PatientId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ShowNewPlanDialog(Guid injuryId)
    {
        var parameters = new DialogParameters
        {
            { nameof(NewTreatmentPlan.InjuryId), injuryId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraExtraLarge,
            FullWidth = true,
            CloseButton = true,
        };

        var dialog = await DialogService.ShowAsync<NewTreatmentPlan>("New Treatment Plan", parameters, options);
        var result = await dialog.Result;
    }
}
