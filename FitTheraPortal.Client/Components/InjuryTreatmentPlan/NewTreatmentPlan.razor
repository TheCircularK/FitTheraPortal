@using System.Runtime.CompilerServices
@using FitTheraPortal.Client.Components.SelfTreatment
@using FitTheraPortal.Client.DataServices.Interfaces
@using FitTheraPortal.Client.Dtos.CreateItems
@using MudBlazor.Extensions

@inject IDialogService DialogService
@inject IInjuryTreatmentPlanDataService PlanService

<div class="container p-4">
    <h4 class="text-center mb-4" style="color: #67baf3;">New Treatment Plan</h4>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="startDate" class="form-label">Start Date</label>
            <input type="date" id="startDate" class="form-control" @bind="_treatmentPlan.StartDate" />
        </div>
        <div class="col-md-6">
            <label for="endDate" class="form-label">End Date</label>
            <input type="date" id="endDate" class="form-control" @bind="_treatmentPlan.EndDate" />
        </div>
    </div>

    <hr class="my-4" />

    <h5 class="mb-4" style="color: #67baf3;">Self Treatments</h5>

    @if (_treatmentPlan.SelfTreatments.Any())
    {
        <ul class="list-group mb-3">
            @foreach (var treatment in _treatmentPlan.SelfTreatments)
            {
                <li class="list-group-item">
                    @treatment.Title
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No self treatments added yet.</p>
    }

    <button class="btn btn-warning w-100 mb-4" @onclick="ShowNewSelfTreatmentDialog">
        ➕ Add Self Treatment
    </button>

    <div class="d-flex justify-content-end">
        <button class="btn btn-primary" @onclick="SaveTreatmentPlan">Save</button>
    </div>
</div>

@code {
    [Parameter]
    public Guid InjuryId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    public Guid TherapistId { get; set; } = new Guid("d1e1fd6a-7ab2-4017-97da-76323df438d0");

    private NewTreatmentPlanDto _treatmentPlan = default!;

    protected override void OnInitialized()
    {
        _treatmentPlan = new NewTreatmentPlanDto
        {
            InjuryId = this.InjuryId,
            TherapistId = this.TherapistId
        };
    }

    private async Task ShowNewSelfTreatmentDialog()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseButton = true,
        };

        var dialog = await DialogService.ShowAsync<NewSelfTreatment>("New Self Treatment", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var data = result.Data.As<NewSelfTreatmentDto>();
            _treatmentPlan.SelfTreatments.Add(data);
        }
    }

    private async Task SaveTreatmentPlan()
    {
        await PlanService.AddNewTreatmentPlanAsync(_treatmentPlan);
        MudDialog.Close();
    }
}
