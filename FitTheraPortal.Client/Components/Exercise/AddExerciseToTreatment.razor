@using FitTheraPortal.Client.DataServices.Interfaces
@using FitTheraPortal.Client.Dtos
@using FitTheraPortal.Client.Dtos.CreateItems

@inject IExerciseDataService ExerciseService
@inject ISnackbar Snackbar

<style>
    .exercise-container {
        display: flex;
        overflow-x: auto;
        gap: 10px;
        padding: 10px;
        scroll-snap-type: x mandatory;
        white-space: nowrap;
    }

    .exercise-card {
        min-width: 200px;
        max-width: 220px;
        scroll-snap-align: start;
        word-wrap: break-word;
        white-space: normal;
    }

    .exercise-title {
        font-size: 0.95rem;
        font-weight: 500;
        margin-bottom: 8px;
        text-align: center;
        word-break: break-word;
    }
    
    .is-selected {
        outline: 1px solid red;
    }
</style>

<div class="container p-4">
    <h4 class="text-center mb-4" style="color: #67baf3;">Add Exercise to Self Treatment Plan</h4>

    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label class="form-label">Duration (seconds)</label>
            <input type="number" class="form-control" @bind="_newExercise.ExerciseDuration" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Rest Length (seconds)</label>
            <input type="number" class="form-control" @bind="_newExercise.RestAfterSeconds" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Weight (lbs)</label>
            <input type="number" class="form-control" @bind="_newExercise.WeightLbs" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Reps</label>
            <input type="number" class="form-control" @bind="_newExercise.Reps" />
        </div>
    </div>

    <hr class="mb-4" />

    <h6 class="mb-2" style="color: #67baf3;">Available Exercises</h6>

    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" id="search" class="form-control" placeholder="Type to search..."
                   @bind="_searchTerm" @bind:event="oninput" />
        </div>
    </div>

    <div class="exercise-container mb-4">
        @foreach (var exercise in FilteredExercises)
        {
            <div class="card exercise-card shadow-sm @( _newExercise.ExerciseId == exercise.Id ? "is-selected" : "")">
                <div class="card-body text-center p-2">
                    <div class="fw-semibold small mb-2" style="min-height: 2.5rem;">@exercise.Name</div>
                    <ExerciseCard Exercise="exercise" />
                    <button class="btn btn-primary btn-sm w-100 mt-2"
                            @onclick="() => SelectExercise(exercise)">
                        Select
                    </button>
                </div>
            </div>
        }
    </div>


    <div class="d-flex justify-content-end">
        <button class="btn btn-primary" @onclick="SelectAndReturn">Add to Plan</button>
    </div>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private IEnumerable<ExerciseDto> _exercises = new List<ExerciseDto>();
    private string _searchTerm = string.Empty;

    private IEnumerable<ExerciseDto> FilteredExercises =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? _exercises
            : _exercises.Where(e => e.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private NewTreatmentExerciseDto _newExercise = new()
    {
        ExerciseDuration = 30,
        Reps = 5,
        RestAfterSeconds = 30,
        WeightLbs = 15,
    };

    protected override async Task OnInitializedAsync()
    {
        await GetExercises();
    }

    private async Task GetExercises()
    {
        _exercises = await ExerciseService.GetAllAsync();
    }

    private void SelectExercise(ExerciseDto exercise)
    {
        _newExercise.ExerciseId = exercise.Id;
        _newExercise.Title = exercise.Name;
        Console.WriteLine($"Selected exercise: {exercise.Name}");
    }

    private void SelectAndReturn()
    {
        if (_newExercise.ExerciseId is null)
        {
            Snackbar.Add("Please select an exercise or press X to cancel.", Severity.Error);
        }
        else
        {
            Console.WriteLine($"Returning with new exercise: {_newExercise.Title}");
            MudDialog.Close(DialogResult.Ok(_newExercise));
        }
    }
}
